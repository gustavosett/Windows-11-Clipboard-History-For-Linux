{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Windows-11-Style-Clipboard-History-Manager",
  "version": "2.5.0",
  "identifier": "io.github.mahdi-arts.clipboard-history",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false
    },
    "windows": [
      {
        "title": "Clipboard History",
        "label": "main",
        "width": 360,
        "height": 480,
        "minWidth": 300,
        "minHeight": 300,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": true
      },
      {
        "title": "Setup - Clipboard History",
        "label": "setup",
        "width": 550,
        "height": 650,
        "resizable": true,
        "minWidth": 400,
        "minHeight": 500,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "skipTaskbar": false,
        "alwaysOnTop": false,
        "center": true,
        "focus": true
      },
      {
        "title": "Settings - Clipboard History",
        "label": "settings",
        "width": 480,
        "height": 520,
        "resizable": false,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "skipTaskbar": false,
        "alwaysOnTop": false,
        "center": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.svg"
    ],
    "category": "Utility",
    "shortDescription": "Windows 11-style Clipboard History Manager",
    "longDescription": "A modern, beautiful clipboard history manager for Linux that mimics the Windows 11 Win+V clipboard experience. Built with Tauri, React, and Rust.",
    "linux": {
      "deb": {
        "depends": [
          "xclip",
          "xdotool",
          "wl-clipboard",
          "acl",
          "polkitd",
          "pkexec",
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "libayatana-appindicator3-1 | libappindicator3-1"
        ],
        "files": {
          "/usr/bin/windows-11-style-clipboard-history-manager": "bundle/linux/wrapper.sh",
          "/etc/udev/rules.d/99-windows-11-style-clipboard-history-input.rules": "bundle/linux/99-windows-11-style-clipboard-history-input.rules",
          "/usr/share/applications/io.github.mahdi-arts.clipboard-history.desktop": "bundle/linux/windows-11-style-clipboard-history-manager.desktop",
          "/usr/share/icons/hicolor/128x128/apps/io.github.mahdi-arts.clipboard-history.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/io.github.mahdi-arts.clipboard-history.png": "icons/icon.png",
          "/usr/share/icons/hicolor/scalable/apps/io.github.mahdi-arts.clipboard-history.svg": "icons/icon.svg",
          "/usr/share/doc/windows-11-style-clipboard-history-manager/apparmor/windows-11-style-clipboard-history-manager": "apparmor/windows-11-style-clipboard-history-manager"
        },
        "postInstallScript": "bundle/linux/postinst.sh",
        "preRemoveScript": "bundle/linux/postrm.sh"
      },
      "rpm": {
        "depends": [
          "xclip",
          "xdotool",
          "wl-clipboard",
          "acl",
          "polkit",
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3"
        ],
        "files": {
          "/usr/bin/windows-11-style-clipboard-history-manager": "bundle/linux/wrapper.sh",
          "/etc/udev/rules.d/99-windows-11-style-clipboard-history-input.rules": "bundle/linux/99-windows-11-style-clipboard-history-input.rules",
          "/usr/share/applications/io.github.mahdi-arts.clipboard-history.desktop": "bundle/linux/windows-11-style-clipboard-history-manager.desktop",
          "/usr/share/icons/hicolor/128x128/apps/io.github.mahdi-arts.clipboard-history.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/io.github.mahdi-arts.clipboard-history.png": "icons/icon.png",
          "/usr/share/icons/hicolor/scalable/apps/io.github.mahdi-arts.clipboard-history.svg": "icons/icon.svg",
          "/usr/share/doc/windows-11-style-clipboard-history-manager/apparmor/windows-11-style-clipboard-history-manager": "apparmor/windows-11-style-clipboard-history-manager"
        },
        "postInstallScript": "bundle/linux/postinst.sh",
        "preRemoveScript": "bundle/linux/postrm.sh"
      }
    },
    "resources": ["bundle/linux/99-windows-11-style-clipboard-history-input.rules"]
  }
}
