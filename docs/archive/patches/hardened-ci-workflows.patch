diff --git a/.github/workflows/e2e.yml b/.github/workflows/e2e.yml
new file mode 100644
index 0000000..154c3d6
--- /dev/null
+++ b/.github/workflows/e2e.yml
@@ -0,0 +1,151 @@
+name: E2E Tests
+
+# Manual end-to-end testing with Playwright against a real Tauri build.
+# تست دستی سرتاسری با Playwright روی بیلد واقعی Tائوری.
+#
+# Runs on workflow_dispatch only (heavy: builds the app, then drives the
+# real binary). All actions are pinned to a full commit SHA, matching the
+# supply-chain contract in docs/CI.md.
+# فقط با اجرای دستی کار می‌کند (سنگین است: برنامه را می‌سازد و باینری
+# واقعی را راه می‌اندازد). همهٔ اکشن‌ها به SHA کامل پین شده‌اند، مطابق
+# قرارداد زنجیرهٔ تأمین docs/CI.md.
+
+on:
+  workflow_dispatch:
+    inputs:
+      browser:
+        description: 'Browser to test'
+        required: false
+        default: 'webkit'
+        type: choice
+        options:
+          - webkit
+          - chromium
+          - firefox
+          - all
+
+permissions:
+  contents: read
+
+concurrency:
+  group: e2e-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  e2e:
+    name: E2E Tests (${{ inputs.browser || 'webkit' }})
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
+        with:
+          persist-credentials: false
+
+      - name: Setup Node.js
+        uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38 # v6
+        with:
+          node-version: '20'
+          cache: 'npm'
+
+      - name: Install Rust (rustup, from rust-toolchain.toml)
+        # rustup ships on GitHub runners; the toolchain is pinned by the
+        # repository's rust-toolchain.toml. No third-party action, retries
+        # on transient network failures.
+        # / toolchain از فایل مخزن پین می‌شود؛ بدون اکشن شخص ثالث، با
+        # تلاش مجدد روی خطاهای گذرای شبکه.
+        run: |
+          set -euo pipefail
+          rustup set profile minimal
+          for attempt in 1 2 3; do
+            if rustup toolchain install; then
+              rustc --version && cargo --version
+              exit 0
+            fi
+            echo "::warning::rustup install failed (attempt ${attempt}/3), retrying in 15s"
+            sleep 15
+          done
+          echo "::error::rustup toolchain install failed after 3 attempts"
+          exit 1
+
+      - name: Cache Cargo
+        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6
+        with:
+          path: |
+            ~/.cargo/bin/
+            ~/.cargo/registry/index/
+            src-tauri/target/
+          key: ${{ runner.os }}-cargo-e2e-${{ hashFiles('**/Cargo.lock') }}
+
+      - name: Install system dependencies
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y \
+            libwebkit2gtk-4.1-dev \
+            build-essential \
+            libssl-dev \
+            libayatana-appindicator3-dev \
+            librsvg2-dev \
+            libxdo-dev \
+            libgtk-3-dev \
+            libglib2.0-dev \
+            xvfb \
+            libnss3 \
+            libatk-bridge2.0-0 \
+            libdrm2 \
+            libgbm1 \
+            libxkbcommon0
+
+      - name: Install npm dependencies
+        run: npm ci
+
+      - name: Build Tauri app
+        run: npm run tauri:build
+        timeout-minutes: 45
+
+      - name: Install Playwright browsers
+        run: npx playwright install --with-deps chromium webkit firefox
+
+      - name: Install Playwright dependencies
+        run: |
+          sudo apt-get install -y \
+            libxcb1 \
+            libxcb-render0 \
+            libxcb-shape0 \
+            libxcb-xfixes0
+
+      - name: Run E2E tests (webkit)
+        if: inputs.browser == 'webkit' || inputs.browser == '' || inputs.browser == 'all'
+        run: npx playwright test --project=webkit --reporter=list
+        timeout-minutes: 30
+
+      - name: Run E2E tests (chromium)
+        if: inputs.browser == 'chromium' || inputs.browser == 'all'
+        run: npx playwright test --project=chromium --reporter=list
+        timeout-minutes: 30
+
+      - name: Run E2E tests (firefox)
+        if: inputs.browser == 'firefox' || inputs.browser == 'all'
+        run: npx playwright test --project=firefox --reporter=list
+        timeout-minutes: 30
+
+      - name: Upload test results
+        if: always()
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7
+        with:
+          name: playwright-results-${{ runner.os }}
+          path: |
+            test-results/
+            playwright-report/
+          if-no-files-found: warn
+          retention-days: 14
+
+      - name: Upload test screenshots
+        if: failure()
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7
+        with:
+          name: playwright-screenshots-${{ runner.os }}
+          path: test-results/**/screenshots/
+          if-no-files-found: warn
+          retention-days: 7
