{
  "name": "windows-11-style-clipboard-history-manager",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "description": "A Windows 11-style Clipboard History Manager for Linux built with Tauri",
  "author": "Mahdi Arts",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mahdi-Arts/Windows-11-Style-Clipboard-History-Manager"
  },
  "keywords": [
    "clipboard",
    "linux",
    "tauri",
    "windows-11",
    "clipboard-manager",
    "rust"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "tsc --noEmit && eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bash scripts/e2e.sh",
    "test:e2e:playwright": "playwright test",
    "test:e2e:playwright:ui": "playwright test --ui",
    "test:e2e:playwright:debug": "playwright test --debug",
    "test:e2e:playwright:headed": "playwright test --headed",
    "test:e2e:playwright:report": "playwright show-report",
    "test:e2e:playwright:install": "playwright install --with-deps chromium webkit",
    "qa:packaging": "bash scripts/check-packaging.sh",
    "qa:all": "npm run lint && npm run test:coverage && npm run test:e2e"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "clsx": "^2.1.0",
    "emojilib": "^4.0.3",
    "fuse.js": "^7.5.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-window": "^2.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@playwright/test": "^1.52.0",
    "@tauri-apps/cli": "^2.11.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "js-yaml": "^5.3.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.25",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  }
}
